<?xml version="1.0"?>
<robot name="huanpan_workcell">
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="drive_tip"/>
  </group>
  <group name="gripper">
    <joint name="R1_1_joint"/>
  </group>

  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-1.5708"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="R1_1_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="R1_1_joint" value="-0.94"/>
  </group_state>

  <end_effector name="disk_gripper" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>

  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="tool0" reason="Adjacent"/>
  <disable_collisions link1="wrist_3_link" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="tool0" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="R1_1_link" reason="Adjacent"/>
  <disable_collisions link1="R1_1_link" link2="R1_2_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="R2_1_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="M_link" reason="Adjacent"/>
  <disable_collisions link1="M_link" link2="MR_link" reason="Adjacent"/>
  <disable_collisions link1="MR_link" link2="MR_1_1_link" reason="Adjacent"/>
  <disable_collisions link1="MR_link" link2="MR_2_1_link" reason="Adjacent"/>
  <disable_collisions link1="M_link" link2="ML_link" reason="Adjacent"/>
  <disable_collisions link1="ML_link" link2="ML_1_1_link" reason="Adjacent"/>
  <disable_collisions link1="ML_link" link2="ML_2_1_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="L1_1_link" reason="Adjacent"/>
  <disable_collisions link1="L1_1_link" link2="L1_2_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="L2_1_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="gripper_tcp" link2="carried_drive" reason="Adjacent"/>
  <disable_collisions link1="carried_drive" link2="drive_tip" reason="Adjacent"/>
  <disable_collisions link1="R1_2_link" link2="carried_drive" reason="Default"/>
  <disable_collisions link1="L1_2_link" link2="carried_drive" reason="Default"/>
  <!-- AG95 is a coupled closed-chain mechanism; these meshes touch in the closed pose. -->
  <disable_collisions link1="L1_2_link" link2="ML_2_1_link" reason="Never"/>
  <disable_collisions link1="ML_1_1_link" link2="gripper_base" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="MR_1_1_link" reason="Never"/>
  <disable_collisions link1="R1_2_link" link2="MR_2_1_link" reason="Never"/>
</robot>
