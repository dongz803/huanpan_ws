  <!-- Fixed task drive: 0.100 W x 0.025 H x 0.175 D. -->
  <link name="carried_drive">
    <inertial>
      <mass value="0.62"/>
      <inertia ixx="0.002099" ixy="0" ixz="0"
        iyy="0.001615" iyz="0" izz="0.000549"/>
    </inertial>
    <visual>
      <geometry><box size="0.025 0.100 0.175"/></geometry>
      <material name="fault_red"/>
    </visual>
    <collision><geometry><box size="0.025 0.100 0.175"/></geometry></collision>
  </link>
  <joint name="gripper_tcp_to_carried_drive" type="fixed">
    <parent link="gripper_tcp"/><child link="carried_drive"/>
    <origin xyz="0 0 0.0875"/>
  </joint>

  <!-- MoveIt insertion goals are expressed at the leading face of the drive. -->
  <link name="drive_tip"/>
  <joint name="carried_drive_to_drive_tip" type="fixed">
    <parent link="carried_drive"/><child link="drive_tip"/>
    <origin xyz="0 0 0.0875"/>
  </joint>

  <link name="rack">
    <!-- Generic floor stand used only to mount the server in the workcell. -->
    <visual><origin xyz="-0.0875 0.235 -0.375"/><geometry><box size="0.036 0.036 0.750"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="-0.0875 -0.235 -0.375"/><geometry><box size="0.036 0.036 0.750"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="-0.0875 0 -0.738"/><geometry><box size="0.070 0.506 0.024"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="-0.0875 0.235 -0.375"/><geometry><box size="0.036 0.036 0.750"/></geometry></collision>
    <collision><origin xyz="-0.0875 -0.235 -0.375"/><geometry><box size="0.036 0.036 0.750"/></geometry></collision>
    <collision><origin xyz="-0.0875 0 -0.738"/><geometry><box size="0.070 0.506 0.024"/></geometry></collision>

    <!-- Measured rack shell: 0.430 W x 0.085 H x 0.175 D. -->
    <visual><origin xyz="0 0 0.0415"/><geometry><box size="0.175 0.430 0.002"/></geometry><material name="rack_gray"/></visual>
    <visual><origin xyz="0 0 -0.0415"/><geometry><box size="0.175 0.430 0.002"/></geometry><material name="rack_gray"/></visual>
    <visual><origin xyz="0 0.214 0"/><geometry><box size="0.175 0.002 0.085"/></geometry><material name="rack_gray"/></visual>
    <visual><origin xyz="0 -0.214 0"/><geometry><box size="0.175 0.002 0.085"/></geometry><material name="rack_gray"/></visual>
    <visual><origin xyz="0.0845 0 0"/><geometry><box size="0.006 0.430 0.085"/></geometry><material name="rack_gray"/></visual>

    <collision><origin xyz="0 0 0.0415"/><geometry><box size="0.175 0.430 0.002"/></geometry></collision>
    <collision><origin xyz="0 0 -0.0415"/><geometry><box size="0.175 0.430 0.002"/></geometry></collision>
    <collision><origin xyz="0 0.214 0"/><geometry><box size="0.175 0.002 0.085"/></geometry></collision>
    <collision><origin xyz="0 -0.214 0"/><geometry><box size="0.175 0.002 0.085"/></geometry></collision>
    <collision><origin xyz="0.0845 0 0"/><geometry><box size="0.006 0.430 0.085"/></geometry></collision>

    <!-- Four horizontal bays by three vertical bays. -->
    <visual><origin xyz="-0.085 0.1575 0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 0.0525 0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 -0.0525 0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 -0.1575 0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 0.1575 0"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 0.0525 0"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 -0.0525 0"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 -0.1575 0"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 0.1575 -0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 0.0525 -0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 -0.0525 -0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
    <visual><origin xyz="-0.085 -0.1575 -0.0275"/><geometry><box size="0.006 0.100 0.025"/></geometry><material name="bay_black"/></visual>
  </link>
  <joint name="world_to_rack" type="fixed">
    <parent link="world"/><child link="rack"/>
    <origin xyz="0.7075 0 0.750"/>
  </joint>

  <link name="slot_09_entry"/>
  <joint name="rack_to_slot_09_entry" type="fixed">
    <parent link="rack"/><child link="slot_09_entry"/>
    <origin xyz="-0.1025 0.0525 -0.0275"/>
  </joint>

  <link name="slot_09_goal"/>
  <joint name="rack_to_slot_09_goal" type="fixed">
    <parent link="rack"/><child link="slot_09_goal"/>
    <origin xyz="0.080 0.0525 -0.0275"/>
  </joint>
</robot>
