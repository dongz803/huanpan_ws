<?xml version="1.0"?>
<package format="3">
  <name>huanpan_motion</name>
  <version>0.1.0</version>
  <description>Application-level MoveIt 2 wrappers for the disk replacement robot.</description>
  <maintainer email="lzt@example.com">lzt</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>huanpan_description</exec_depend>
  <exec_depend>huanpan_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
