.venv/
.venv-perception/
.deps/
build/
install/
log/
__pycache__/
*.py[cod]
# Runtime outputs are ignored by default. A small, reviewed allowlist of
# reproducible experiment artifacts is kept below.
/outputs/**
!/outputs/README.md
!/outputs/force_traces/
!/outputs/force_traces/*.csv
!/outputs/perception/
!/outputs/perception/eval/
!/outputs/perception/eval/slot_opening_v1/
!/outputs/perception/eval/slot_opening_v1/metrics.json
!/outputs/perception/fine_localization/
!/outputs/perception/fine_localization/*/
!/outputs/perception/fine_localization/*/summary.json
!/outputs/perception/fine_localization/*/results.json
!/outputs/perception/runs/
!/outputs/perception/runs/slot_opening_v1/
!/outputs/perception/runs/slot_opening_v1/args.yaml
!/outputs/perception/runs/slot_opening_v1/train_invocation.json
!/outputs/perception/runs/slot_opening_v1/results.csv
!/outputs/perception/runs/slot_opening_v1/results.png
!/outputs/perception/runs/slot_opening_v1/labels.jpg
!/outputs/perception/runs/slot_opening_v1/Box*_curve.png
!/outputs/perception/runs/slot_opening_v1/confusion_matrix*.png
!/outputs/perception/runs/slot_opening_v1/weights/
!/outputs/perception/runs/slot_opening_v1/weights/best.pt
.pytest_cache/
# Third-party source repositories
src/moveit2/
src/moveit_msgs/
src/moveit_resources/

# Codex and temporary data
.codex*/
.agents/
.chart-data-*/
.firecrawl/

# Downloaded models and incomplete downloads
/weights/
*.part
.vscode/
